# Vorlage: nach .env kopieren und anpassen (.env nicht ins Repo einchecken)
# Moderator-PIN (/host, Startseite → „Moderator werden“). Leer lassen: der Server erzeugt eine
# 6-stellige PIN in data/host-pin und zeigt sie im Log (docker compose logs quiz)
HOST_PIN=

# Öffentliche Adresse (für Anmelde-Links und Google/Facebook nötig), z. B. https://quiz.example.at
PUBLIC_URL=

# Anmelde-Links per E-Mail (ohne SMTP_URL ausgeschaltet; MAIL_LOG=1 schreibt die Links zum Testen ins Log)
# MAIL_LOG=1
# SMTP_URL=smtps://benutzer:passwort@smtp.example.at:465
# MAIL_FROM=Quiz-Party <quiz@example.at>

# Anmeldung mit Google (console.cloud.google.com → OAuth-Client, Redirect: <PUBLIC_URL>/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Anmeldung mit Facebook (developers.facebook.com, Redirect: <PUBLIC_URL>/auth/facebook/callback)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
